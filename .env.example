APP_NAME="DMS CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dmssoftware.agency

LOG_CHANNEL=stack
LOG_LEVEL=error

# DATABASE - change password to your hosting value.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dmssoftware_crm
DB_USERNAME=dmssoftware_crm
DB_PASSWORD=your_password_here

# SESSION
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# CACHE
CACHE_STORE=file

# QUEUE
QUEUE_CONNECTION=sync

# ANTHROPIC AI (for AI Agent feature)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# MAIL (for email reminders)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DMS CRM"

# COMPANY INFO
COMPANY_NAME="DMS Software"
COMPANY_PHONE="+880-XXX-XXXXXXX"
COMPANY_EMAIL="info@dmssoftware.agency"
COMPANY_ADDRESS="Dhaka, Bangladesh"
